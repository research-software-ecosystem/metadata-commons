@prefix biocontainers: <https://biocontainers.pro/tools/> .
@prefix schema1: <http://schema.org/> .

biocontainers:ngsep a schema1:SoftwareApplication ;
    schema1:description "Ngsep - next generation sequencing experience platform" ;
    schema1:keywords "Clustering",
        "Genetics",
        "Genomics",
        "Ortholog",
        "RNA-Seq",
        "Sequence Alignment",
        "Transcriptome",
        "Whole genome sequencing" ;
    schema1:license "GPL-3" ;
    schema1:name "ngsep" ;
    schema1:url <https://github.com/NGSEP/NGSEPcore> .

