@prefix bioconda: <https://github.com/bioconda/bioconda-recipes/tree/master/recipes/> .
@prefix biotools: <https://bio.tools/> .
@prefix edam: <http://edamontology.org/> .
@prefix galaxytool: <https://github.com/galaxyproject/tools-iuc/tree/master/tools/> .
@prefix schema1: <http://schema.org/> .

galaxytool:vg a schema1:SoftwareApplication ;
    schema1:description "Variation graph data structures, interchange formats, alignment, genotyping, and variant calling methods" ;
    schema1:featureList edam:operation_3209 ;
    schema1:identifier biotools:vg,
        bioconda:vg ;
    schema1:isPartOf <https://usegalaxy.eu>,
        <https://usegalaxy.eu/published/workflow?id=9ba580ba8b01db40> ;
    schema1:keywords "Sequence Analysis",
        "Variant Analysis" ;
    schema1:name "vg" ;
    schema1:softwareVersion "1.73.0" ;
    schema1:url "https://github.com/vgteam/vg" .

<https://usegalaxy.eu> a schema1:WebSite .

