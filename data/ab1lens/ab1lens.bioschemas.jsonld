      "sc:author": "Fishka Bio",
      "sc:citation": {
        "@id": "https://doi.org/10.5281/zenodo.21444547"
      },
      "sc:description": "Browser-based viewer for Sanger sequencing chromatograms in AB1/ABIF and SCF format. Opens .ab1/.abi/.fsa files, shows raw and analysed traces, basecalls, quality values and the ABIF directory, and puts two reads side by side for comparison. Aligns a read against a reference sequence to highlight mismatches. Exports the read as FASTA, FASTQ or ABIF and the chromatogram as a high-resolution image. Runs entirely in the browser — files are never uploaded.",
      "sc:featureList": [
        {
          "@id": "edam:operation_0491"
        },
        {
          "@id": "edam:operation_3203"
        }
      ],
      "sc:isAccessibleForFree": true,
      "sc:license": "Freeware",
      "sc:name": "ab1lens",
      "sc:operatingSystem": [
        "Linux",
        "Mac",
        "Windows"
      ],
      "sc:url": "https://fishka.bio/ab1lens"
    },
